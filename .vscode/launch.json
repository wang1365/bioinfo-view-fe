{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Application",
            "type": "pwa-chrome",
            "request": "launch",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "npm: dev",
            "sourceMaps": true,
            "userDataDir": "${workspaceFolder}/.vscode/chrome-debug", // 添加这行
            "runtimeExecutable": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" // 确保路径正确
        },
        {
            "name": "Debug Tests",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "test"],
            "port": 9229,
            "console": "externalTerminal",
            "terminalOptions": {
                "shellPath": "cmd.exe"
            }
        }
    ]
}
